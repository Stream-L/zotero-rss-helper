{
  "manifest_version": 2,
  "name": "Zotero RSS Helper",
  "version": "0.4.0",
  "description": "Enrich Zotero RSS items with DOI and Crossref metadata, then translate and screen them with AI.",
  "icons": {
    "48": "content/icons/rss-helper.svg",
    "96": "content/icons/rss-helper.svg"
  },
  "applications": {
    "zotero": {
      "id": "zotero-rss-helper@github.com",
      "update_url": "https://example.com/zotero-rss-helper/update.json",
      "strict_min_version": "10.0",
      "strict_max_version": "10.*"
    }
  }
}
